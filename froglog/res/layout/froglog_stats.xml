<?xml version="1.0" encoding="utf-8"?>
<!-- Laid out like Cocoon's Playtime widget: a header, the total, then daily bars. The
     provider shows the figures, side chart and top game only when the tile has room. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/froglog_stats_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingLeft="10dp"
    android:paddingTop="8dp"
    android:paddingRight="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/froglog_stats_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/froglog_stats_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="5dp"
            android:src="@drawable/froglog_title_icon" />

        <TextView
            android:id="@+id/froglog_stats_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_semibold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Froglog"
            android:textColor="#3BCF7A"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/froglog_stats_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:textColor="#3BCF7A"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/froglog_stats_message_box"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/froglog_stats_message_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/froglog_title_icon" />

        <TextView
            android:id="@+id/froglog_stats_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="#1C1C1E"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/froglog_stats_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/froglog_stats_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/froglog_stats_hero_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/froglog_stats_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="0h"
                    android:textColor="#1C1C1E"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/froglog_stats_month_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="this month"
                    android:textColor="#8E8E93"
                    android:textSize="10sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/froglog_stats_chart_side"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/froglog_stats_spacer"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/froglog_stats_figures"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="horizontal"
                android:visibility="gone">

            <LinearLayout
                android:id="@+id/froglog_stats_week_box"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/froglog_stats_week"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#1C1C1E"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/froglog_stats_week_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="7 days"
                    android:textColor="#8E8E93"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/froglog_stats_year_box"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/froglog_stats_year_hours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#1C1C1E"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/froglog_stats_year_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="this year"
                    android:textColor="#8E8E93"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/froglog_stats_done_box"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/froglog_stats_done"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#1C1C1E"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/froglog_stats_done_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="finished"
                    android:textColor="#8E8E93"
                    android:textSize="9sp" />
            </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/froglog_stats_chart"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/froglog_stats_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/froglog_stats_top_art"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/froglog_stats_top_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Top this month"
                    android:textColor="#8E8E93"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/froglog_stats_top_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#1C1C1E"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/froglog_stats_top_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:textColor="#3BCF7A"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
