<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/froglog_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="14dp"
    android:paddingRight="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/froglog_title_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="6dp"
            android:src="@drawable/froglog_title_icon" />

        <TextView
            android:id="@+id/froglog_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_medium"
            android:maxLines="1"
            android:text="Froglog"
            android:textColor="#3BCF7A"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/froglog_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:paddingLeft="8dp"
            android:text="Recent"
            android:textColor="#3BCF7A"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/froglog_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_regular"
        android:maxLines="1"
        android:textColor="#8E8E93"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/froglog_message"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:text="No play history yet"
        android:textColor="#1C1C1E"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/froglog_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/froglog_slot0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/froglog_art0"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/froglog_cover_placeholder"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/froglog_cover_placeholder" />

            <TextView
                android:id="@+id/froglog_name0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#1C1C1E"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/froglog_meta0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#8E8E93"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/froglog_slot1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/froglog_art1"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/froglog_cover_placeholder"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/froglog_cover_placeholder" />

            <TextView
                android:id="@+id/froglog_name1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#1C1C1E"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/froglog_meta1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#8E8E93"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/froglog_slot2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/froglog_art2"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/froglog_cover_placeholder"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/froglog_cover_placeholder" />

            <TextView
                android:id="@+id/froglog_name2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#1C1C1E"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/froglog_meta2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#8E8E93"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/froglog_slot3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/froglog_art3"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/froglog_cover_placeholder"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/froglog_cover_placeholder" />

            <TextView
                android:id="@+id/froglog_name3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#1C1C1E"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/froglog_meta3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#8E8E93"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
