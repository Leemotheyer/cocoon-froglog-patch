<?xml version="1.0" encoding="utf-8"?>
<!-- Laid out like Cocoon's Recently played: header, then square cover rows. The provider
     picks one or two columns, the row count and every size from the tile it is given. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/froglog_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingLeft="10dp"
    android:paddingTop="8dp"
    android:paddingRight="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/froglog_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/froglog_title_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/froglog_title_icon" />

        <TextView
            android:id="@+id/froglog_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_semibold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Froglog"
            android:textColor="#3BCF7A"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/froglog_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="Recent"
            android:textColor="#3BCF7A"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/froglog_message_box"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/froglog_message_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/froglog_title_icon" />

        <TextView
            android:id="@+id/froglog_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:maxLines="2"
            android:text="Your recent Froglog games"
            android:textColor="#1C1C1E"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
